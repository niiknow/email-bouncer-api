{
    "name": "niiknow/email-bouncer-api",
    "description": "Email bounce",
    "keywords": ["framework", "fatfree", "email", "bounce", "RESTfull", "API"],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "bcosca/fatfree-core": "^3.9.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "phpunit/phpunit": "^13.4.6",
        "mockery/mockery": "^1.6.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf -w",
        "app:clear": [
            "rm -f dist.tar",
            "rm -f ./storage/cache/*.*",
            "rm -f ./public/tmp/cache/*.*",
            "rm -f ./storage/data/*.sqli*",
            "composer dump-autoload"
        ],
        "app:package": [
            "composer app:clear",
            "composer install --no-dev --optimize-autoloader",
            "composer archive",
            "mv dist-*.tar dist.tar",
            "tar -rvf dist.tar vendor"
        ],
        "app:production": [
            "composer app:clear",
            "echo 'composer install --no-dev --optimize-autoloader'"
        ]
    },
    "archive": {
        "name": "dist",
        "exclude": [
            ".docker/",
            "coverage/",
            "dist/",
            "node_modules/",
            "tests/",
            "vendor/",
            ".DS_Store",
            ".env",
            ".phpunit.result.cache",
            "*.md",
            "*.xml"
        ]
    }
}
